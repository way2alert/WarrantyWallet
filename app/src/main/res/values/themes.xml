<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Base application theme using Material 3 DayNight -->
    <style name="Theme.WarrantyWallet" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:statusBarColor">@color/brand_primary</item>
        <item name="android:navigationBarColor">@color/background_light</item>
        <item name="android:windowLightNavigationBar">true</item>
    </style>

    <!-- Splash Screen theme using modern AndroidX SplashScreen API -->
    <style name="Theme.WarrantyWallet.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/brand_primary</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_splash_logo</item>
        <item name="postSplashScreenTheme">@style/Theme.WarrantyWallet</item>
    </style>
</resources>
